<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">SignUp on Basera</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
              <label for="username" class="form-lable">Username</label>
              <input 
                name="username"
                id="username"
                type="text"
                class="form-control"
                required/>
                <div class="valid-feedback">looks good!</div>
                <div class="invalid-feedback">Please enter vaild userid name</div>
            </div>
             <div class="mb-3">
              <label for="email" class="form-lable">Email</label>
              <input 
                name="email"
                id="email"
                type="text"
                class="form-control"
                required/>   
            </div>

            
             <div class="mb-3">
              <label for="password" class="form-lable">Password</label>
              <input 
                name="password"
                id="password"
                type="password"
                class="form-control"
                required/>   
            </div>

         </div>
          <button class="btn btn-success col-1 offset-3">SignUp</button>

        </form>
    </div>
</div>